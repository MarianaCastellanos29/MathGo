{
  "info": {
    "name": "MathGo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "usuarioId", "value": "1" }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Registro de usuario",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/usuarios/registro",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"correo\": \"juan@test.com\",\n  \"password\": \"123456\",\n  \"rol\": \"ALUMNO\"\n}"
            }
          }
        },
        {
          "name": "Login (obtener JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('token', res.token);",
                  "pm.collectionVariables.set('usuarioId', res.usuarioId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/usuarios/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan@test.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📚 Ejercicios",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ejercicios",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Ejercicios por nivel (nivel 1)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ejercicios/nivel/{{usuarioId}}/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Responder ejercicio",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/ejercicios/responder",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"ejercicioId\": 1,\n  \"respuesta\": \"B\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📊 Progreso",
      "item": [
        {
          "name": "Obtener progreso del usuario",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/progreso/{{usuarioId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "👥 Usuarios",
      "item": [
        {
          "name": "Listar todos los usuarios",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/usuarios",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/usuarios/{{usuarioId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
